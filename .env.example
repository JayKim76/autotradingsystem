# ============================================================
#  환경변수 템플릿
#  → cp .env.example .env  후 아래 값들을 채워넣으세요
#  ⚠️  .env 파일은 절대 git 에 커밋하지 마세요
# ============================================================

# ─── 거래 모드 ────────────────────────────────────────────
TRADE_MODE=paper          # paper (모의투자) / real (실전투자)

# ─── Phase 0 실전 잠금 (2026-11-24~) ──────────────────────
# 검증 게이트 PASS 전략이 없고 paper 전진 검증 30건이 쌓이기 전에는
# TRADE_MODE=real 로 둬도 시작이 차단됩니다 (src/live_guard.py).
# 해제 조건 4가지를 모두 충족하고 사용자가 명시적으로 결정한 경우에만
# 아래 값을 1 로 바꾸세요. 해제 이력은 데이터사용대장.md 에 기록합니다.
LIVE_TRADING_ENABLED=0

# ─── 모의투자 API 키 ──────────────────────────────────────
KIS_PAPER_APP_KEY=PSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIS_PAPER_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIS_PAPER_CANO=50012345           # 계좌번호 앞 8자리
KIS_PAPER_ACNT_PRDT_CD=01         # 계좌번호 뒤 2자리

# ─── 실전투자 API 키 (선택) ───────────────────────────────
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_CANO=
KIS_REAL_ACNT_PRDT_CD=01

# ─── 텔레그램 알림 (선택) ────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321
